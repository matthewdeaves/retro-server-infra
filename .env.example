# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   cp .env.example .env
#
# Nothing here is read automatically by your shell — `bin/retro` and the tofu
# wrappers source it explicitly.

# ------------------------------------------------------------------ Cloudflare
# Scoped API token: Zone/DNS:Edit on your domain, plus account-level
# Cloudflare Tunnel:Edit, Access: Apps and Policies:Edit, Access:
# Organizations, Identity Providers and Groups:Edit.
# Created at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Not secret. From the domain Overview page, right sidebar.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=your-domain.com

# ---------------------------------------------------------------------- server
# Filled in after `terraform/compute` has been applied:
#   cd terraform/compute && tofu output -raw public_ip
RETRO_SERVER_IP=
RETRO_SSH_USER=ubuntu
RETRO_SSH_KEY=~/.ssh/id_ed25519

# -------------------------------------------------------------------- admins
# Addresses that may authenticate to the admin UI via Cloudflare Access
# one-time PIN. Comma separated. Must match admin_emails in
# terraform/cloudflare/terraform.tfvars.
RETRO_ADMIN_EMAILS=you@example.com

# How long an address added by `retro allow` stays in the nftables players set.
RETRO_ALLOW_TTL=12h

# Used by `retro stop|start|dns-sync`.
RETRO_TENANCY_OCID=
