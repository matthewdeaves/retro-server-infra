# Deployment-specific values for the admin UI. Copy to /etc/retro-admin/admin.env
# on the box (not tracked in git — create it directly with `retro ssh`, or add
# it to your own deploy step). retro-admin.service reads it via EnvironmentFile.
#
#   sudo mkdir -p /etc/retro-admin
#   sudo cp admin/retro-admin.env.example /etc/retro-admin/admin.env
#   sudo chmod 600 /etc/retro-admin/admin.env
#   # then fill in the real values below on the box

# The hostname the admin UI is reached at (behind Cloudflare Access).
RETRO_PUBLIC_HOST=admin.your-domain.example

# The hostname players connect game clients to.
RETRO_GAMES_HOST=games.your-domain.example

# Your Cloudflare Zero Trust team domain: <team-name>.cloudflareaccess.com
RETRO_TEAM_DOMAIN=your-team.cloudflareaccess.com

# The Access application's Audience (AUD) tag. Cloudflare Zero Trust dashboard
# -> Access -> Applications -> your app -> Overview.
RETRO_ACCESS_AUD=

# Who may authenticate, comma separated. Must match admin_emails in
# terraform/cloudflare/terraform.tfvars -- Cloudflare decides who gets a
# token, this decides who is let in with one, and an address needs to pass
# both checks.
RETRO_ADMIN_EMAILS=you@example.com

# The contact address Web Push sends to the push service in the VAPID JWT.
# Required for real: leaving this at a placeholder gets every push silently
# rejected (403) by Apple/Google's push service, not just "untested" --
# hit for real 2026-08-31, missing from this file on first deploy.
RETRO_VAPID_SUBJECT=mailto:you@example.com
